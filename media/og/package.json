{
  "name": "@echovisionlab/geul-og",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Geul OG image generation worker",
  "author": "state303 <state303@dsub.io>",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/echovisionlab/geul-og.git"
  },
  "homepage": "https://github.com/echovisionlab/geul-og#readme",
  "bugs": {
    "url": "https://github.com/echovisionlab/geul-og/issues"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "eslint --cache .",
    "lint-fix": "eslint --cache . --fix",
    "typecheck": "tsc --noEmit",
    "type-check": "pnpm typecheck",
    "test": "vitest run",
    "check:ci-script-syntax": "node --check scripts/ci/docker-package-manifests.mjs",
    "test:ci-scripts": "node --test scripts/ci/*.test.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check:dead-code": "knip",
    "smoke:release-syntax": "node --check dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "@echovisionlab/geul-event": "0.4.1",
    "@echovisionlab/geul-proto": "0.4.1",
    "@echovisionlab/geul-telemetry": "0.1.4",
    "@hono/node-server": "^2.1.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "satori": "^0.35.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "knip": "^6.39.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "24.21.0"
  }
}
