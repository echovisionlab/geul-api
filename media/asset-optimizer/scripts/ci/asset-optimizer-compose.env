GEUL_ASSET_OPTIMIZER_RUNTIME_NETWORK_NAME=geul-runtime
GEUL_ASSET_OPTIMIZER_IMAGE=registry.dsub.io/echovisionlab/geul-asset-optimizer:v0.1.0-test
GEUL_ASSET_OPTIMIZER_PORT=3030
GEUL_ASSET_OPTIMIZER_LOG_LEVEL=info
GEUL_ASSET_OPTIMIZER_DATABASE_DSN=postgres://geul_asset_optimizer:change-me@postgres.example.invalid:5432/geul?sslmode=disable
GEUL_ASSET_OPTIMIZER_S3_ENDPOINT=http://minio.example.invalid:9000
GEUL_S3_MEDIA_BUCKET=media
GEUL_S3_REGION=us-east-1
GEUL_ASSET_OPTIMIZER_S3_ACCESS_KEY_ID=minioadmin
GEUL_ASSET_OPTIMIZER_S3_SECRET_ACCESS_KEY=minioadmin
GEUL_S3_FORCE_PATH_STYLE=true
GEUL_ASSET_OPTIMIZER_TEMP_DIR=/tmp/asset-optimizer
GEUL_ASSET_OPTIMIZER_MAX_INPUT_BYTES=52428800
GEUL_ASSET_OPTIMIZER_WORKER_COUNT=1
GEUL_ASSET_OPTIMIZER_JOB_TIMEOUT=20
